# Phase 9A: TestFlight Build Environment Variables
# Copy this file to .env.testflight and fill in your values
# DO NOT commit this file to git if it contains real API keys!

################################################################################
# Apple Developer Settings
################################################################################

# Your Apple Developer Team ID (10 character code)
# Find at: https://developer.apple.com/account/#!/membership/
APPLE_TEAM_ID=XXXXXXXXXX

# App Bundle Identifier
APP_BUNDLE_ID=com.yourwish.nuripazu

# App Display Name
APP_DISPLAY_NAME=ぬりパズ動物園

# Minimum iOS Version
MIN_IOS_VERSION=14.0

################################################################################
# Build Versioning
################################################################################

# Semantic Version (X.Y.Z format)
VERSION=0.1.0

# Build number (increment for each TestFlight build)
BUILD_NUMBER=1

# Build Configuration (Release for production)
BUILD_CONFIGURATION=Release

################################################################################
# Firebase (Production)
################################################################################

# Firebase Project ID (production)
FIREBASE_PROJECT_ID_PROD=nuripazu-prod

# Firebase Web API Key
FIREBASE_WEB_API_KEY_PROD=your_firebase_web_api_key_here

# Firebase App ID (iOS)
FIREBASE_APP_ID_PROD=1:123456789012:ios:abcdef1234567890

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID_PROD=123456789012

################################################################################
# RevenueCat (Production)
################################################################################

# RevenueCat API Key (Production)
# Get from: https://app.revenuecat.com/settings
REVENUE_CAT_API_KEY_PROD=appl_xxxxxxxxxxxxxxxxxxxxxxxxx

################################################################################
# Google Mobile Ads (Production)
################################################################################

# AdMob App ID
# Get from: https://admob.google.com/
ADMOB_APP_ID_PROD=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# AdMob Banner Unit ID (for display ads)
ADMOB_BANNER_ID_PROD=ca-app-pub-3940256099942544/2934735716

# AdMob Rewarded Unit ID (for reward ads)
ADMOB_REWARDED_ID_PROD=ca-app-pub-3940256099942544/5224354917

################################################################################
# Signing Configuration
################################################################################

# Code Signing Identity (from Keychain)
# Usually "Apple Distribution" for production
CODE_SIGNING_IDENTITY=Apple Distribution

# Provisioning Profile Name
# Must match the App Store Distribution profile
PROVISIONING_PROFILE_NAME=Nuripazu App Store Distribution

################################################################################
# Export Options
################################################################################

# Export method (app-store for TestFlight/App Store)
EXPORT_METHOD=app-store

# Include bitcode (true/false)
# Note: App Store no longer requires bitcode
INCLUDE_BITCODE=false

# Manage version and build numbers automatically
# Set to true to use Xcode's automatic versioning
AUTO_MANAGE_VERSIONING=false

################################################################################
# Optional: Deployment Settings
################################################################################

# Test flight recipient email addresses (comma-separated)
# For immediate TestFlight build distribution
TESTFLIGHT_RECIPIENTS=developer@yourwish.dev,qa@yourwish.dev

# Release notes for this TestFlight build
RELEASE_NOTES="Version 0.1.0 - Initial TestFlight Beta"

# Build output directory
BUILD_OUTPUT_DIR=build/ios_build

################################################################################
# Instructions
################################################################################

# 1. Copy this file:
#    cp .env.testflight.example .env.testflight
#
# 2. Fill in all values with your actual credentials
#
# 3. Load environment variables before building:
#    source .env.testflight
#
# 4. Run the build script:
#    ./scripts/build_testflight.sh \
#      --version $VERSION \
#      --build $BUILD_NUMBER \
#      --team $APPLE_TEAM_ID \
#      --export-team $APPLE_TEAM_ID
#
# 5. Upload the generated IPA to App Store Connect via Transporter
#
# IMPORTANT: Never commit .env.testflight to git!
